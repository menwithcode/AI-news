DATABASE_URL=
SEMANTIC_SCHOLAR_API_KEY=

# Optional: hours of history to pull per run for RSS/GitHub sources.
# Daily cron leaves this unset (defaults to 24). Set higher for a
# one-off backfill, e.g. LOOKBACK_HOURS=720 for 30 days. Note: arXiv's
# RSS feed only ever contains the current day regardless of this value
# -- use `python -m ingest.arxiv_backfill` for real arXiv history.
LOOKBACK_HOURS=
